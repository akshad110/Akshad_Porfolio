# MongoDB
MONGODB_URI=mongodb://localhost:27017/akshad-portfolio

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js / NextAuth
AUTH_SECRET=replace-with-a-long-random-string
# Leave AUTH_URL unset locally so the current host/port is used.
# AUTH_URL=https://your-production-domain.com
AUTH_TRUST_HOST=true

# Admin credentials (used by the seed script and credentials provider)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Resend (contact form emails)
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=jagrutivengurlekar@gmail.com
# Optional: verified sender on your Resend domain. Defaults to onboarding@resend.dev
# RESEND_FROM_EMAIL=Akshad Portfolio <onboarding@resend.dev>

# Production (Render) checklist:
# NEXT_PUBLIC_SITE_URL=https://your-service.onrender.com
# AUTH_URL=https://your-service.onrender.com
# AUTH_TRUST_HOST=true
